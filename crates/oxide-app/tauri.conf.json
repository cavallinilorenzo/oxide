{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oxide",
  "version": "0.1.0",
  "identifier": "dev.oxide.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Oxide",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#0f1115",
        "maximized": true,
        "minWidth": 1064,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://github.com https://avatars.githubusercontent.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5RTg4Qjk0RTBGRTlCRjEKUldUeG0vN2dsSXZvQ2FkZHd2bFBJTDM3MTZJRE1GWHFFUXh1ejEvN3VIcFJ2YmtwbzM5N21OT3kK",
      "endpoints": ["https://github.com/cavallinilorenzo/oxide/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "resources": { "../../docs/licenses/whisper.txt": "licenses/whisper.txt" },
    "targets": ["app", "dmg", "nsis", "msi"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
